# Flask Configuration
PORT=5000
FLASK_ENV=development

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Neon PostgreSQL Database Connection String
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# Transcript Proxy (required on Render & other cloud servers where YouTube blocks requests)
# Get a proxy from Webshare (webshare.io), Oxylabs, Brightdata, or any HTTPS/SOCKS5 provider
# Format: https://user:password@host:port
TRANSCRIPT_PROXY_URL=
